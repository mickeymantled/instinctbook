# Copy to .env for local development. Never commit the real .env file.
# See src/config.ts for validation rules; invalid values fail startup with the
# offending variable names (never their values) in the error message.

# development | test | production
NODE_ENV=development

# Interface and port the API listens on.
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Included as the "service" field on every structured log line.
SERVICE_NAME=ibook-api

# Optional for now (slice 1.2). Slice 1.3 (database and worker) makes these required.
DATABASE_URL=postgres://ibook:ibook@localhost:5432/ibook
REDIS_URL=redis://localhost:6379
