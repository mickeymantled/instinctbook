{
  "name": "@ibook/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "otel-register.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node --import ./otel-register.mjs dist/main.js"
  },
  "dependencies": {
    "@ibook/db": "workspace:*",
    "@ibook/observability": "workspace:*",
    "@ibook/queue": "workspace:*",
    "@opentelemetry/instrumentation": "^0.222.0",
    "bullmq": "^6.3.8",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
