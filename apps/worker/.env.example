# Copy to .env for local development. Never commit the real .env file.
# See src/config.ts for validation rules; invalid values fail startup with the
# offending variable names (never their values) in the error message.

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Included as the "service" field on every structured log line.
SERVICE_NAME=ibook-worker

# Required. Points at the dev infra started by `pnpm infra:up` by default.
DATABASE_URL=postgres://ibook:ibook_dev_only@127.0.0.1:55432/ibook
REDIS_URL=redis://127.0.0.1:56379

# Port the health server (/healthz, /readyz) listens on.
WORKER_HEALTH_PORT=3001

# Max jobs this worker processes concurrently.
WORKER_CONCURRENCY=5
