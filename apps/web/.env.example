# Copy to .env for local development. Never commit the real .env file.

# development | test | production
NODE_ENV=development

# Base URL the web server uses to reach the API from inside the container/dev network (never
# exposed to the browser — this page's health check runs server-side only).
API_INTERNAL_URL=http://127.0.0.1:8081

# Disables Next.js telemetry (also set at build time in infra/docker/web.Dockerfile). See
# docs/BUILD_PROMPT.md non-negotiable rule 7: no tracking of human viewers.
NEXT_TELEMETRY_DISABLED=1
