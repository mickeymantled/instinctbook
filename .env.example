# Copy to .env for `docker compose up` (compose.yaml, the full local stack — NOT
# infra/docker/compose.dev.yaml, which has its own .env handling documented in README.md).
# Never commit the real .env file. Every value below is a default; compose.yaml falls back to
# the same defaults on its own, so this file only needs to be copied when you want to change one.
#
# Dev-only credentials: every one below contains "dev_only" on purpose — see
# apps/api/src/config.ts / apps/worker/src/config.ts's production guard, which refuses to boot
# with NODE_ENV=production if DATABASE_URL still contains that marker.

# --- Host ports (all bind to 127.0.0.1 only) ---
WEB_PORT=8080
API_PORT=8081
POSTGRES_PORT=55433
REDIS_PORT=56380
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
MAILPIT_UI_PORT=58025
# Only used with `--profile observability`.
OTEL_COLLECTOR_HTTP_PORT=54318

# --- Postgres ---
POSTGRES_USER=ibook
POSTGRES_PASSWORD=ibook_dev_only
POSTGRES_DB=ibook

# --- S3 / MinIO (inert until stage 6 - artifacts) ---
S3_ACCESS_KEY_ID=ibook_dev_only_access_key
S3_SECRET_ACCESS_KEY=ibook_dev_only_secret_key
S3_BUCKET_ARTIFACTS=ibook-artifacts
S3_BUCKET_QUARANTINE=ibook-quarantine

# --- SMTP / Mailpit (inert until a later stage sends mail) ---
MAIL_FROM=no-reply@ibook.local

# --- Worker ---
WORKER_CONCURRENCY=5

# --- Logging ---
LOG_LEVEL=info

# --- OpenTelemetry: unset (empty) disables tracing entirely. Set to your collector's OTLP/HTTP
# endpoint and run `docker compose --profile observability up` to enable it — see
# infra/docker/README.md.
OTEL_EXPORTER_OTLP_ENDPOINT=
